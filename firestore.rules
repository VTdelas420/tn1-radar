rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Releases: anyone can read; a signed-in visitor can create one owned by them;
    // only the owner can change or remove it.
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        // Launch phase: pin must be inside DF + Entorno (same rectangle as src/config/region.ts, plus margin)
        && request.resource.data.regionVerifiedAt is number
        && request.resource.data.state in ['DF', 'GO']
        && request.resource.data.coordinates.lat is number
        && request.resource.data.coordinates.lng is number
        && request.resource.data.coordinates.lat >= -17.15
        && request.resource.data.coordinates.lat <= -14.85
        && request.resource.data.coordinates.lng >= -49.1
        && request.resource.data.coordinates.lng <= -47.0;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Reviews: anyone can read; signed-in visitors can create their own, rating 1–5.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewText is string
        && request.resource.data.reviewText.size() <= 5000;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
