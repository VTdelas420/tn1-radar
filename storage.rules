rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Covers and audio for releases. Public to read; artist accounts may upload
    // images up to 15 MB and audio up to 200 MB. Files cannot be overwritten.
    match /releases/{projectId}/{fileName} {
      allow read: if true;
      // Real accounts only (Google / e-mail), and only artists can upload
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'artist'
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size < 200 * 1024 * 1024)
        );
    }

    // Event flyers: any real account with a profile, images up to 10 MB, no overwrite
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
